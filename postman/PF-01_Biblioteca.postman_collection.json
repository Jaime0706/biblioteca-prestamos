      "name": "1. Libros (CRUD y filtros)",
      "item": [
        {
          "name": "Registrar libro (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('isbnNuevo', '978' + Math.floor(Math.random()*1e10).toString().padStart(10,'0'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código HTTP 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('libroNuevoId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "libros"
              ]
