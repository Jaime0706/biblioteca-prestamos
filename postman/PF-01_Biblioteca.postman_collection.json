{
  "info": {
    "name": "PF-01 Biblioteca Comunitaria - API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar con la BD cargada con database/01_crear_estructura.sql y 02_datos_prueba.sql. Las carpetas 1 a 3 deben ejecutarse en orden (Run collection)."
  },
