    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "libroNuevoId",
      "value": "1"
    },
    {
      "key": "prestamoNuevoId",
      "value": "1"
    },
    {
      "key": "isbnNuevo",
      "value": "9781234567890"
    }
